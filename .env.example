# Copy to .env and fill in. Never commit .env.
# See README.md "Configuration" for what each variable does.

# Google AI Studio key (free tier). Required for live Gemini audits.
GEMINI_API_KEY=

# LLM model. Restricted to the free-tier allowlist in core/agent/llm_throttle.py.
GEMINI_MODEL=gemini-3.5-flash-lite

# SQLAlchemy connection string for the app role.
DATABASE_URL=postgresql+psycopg2://procureai:procureai@localhost:5432/procureai_db

# Docker Compose app-role credentials (override for anything beyond a local demo).
APP_DB_USER=procureai
APP_DB_PASSWORD=procureai
APP_DB_NAME=procureai_db

# Dashboard -> API base URL.
PROCUREAI_API_URL=http://localhost:8000

# ReAct loop step cap.
AGENT_MAX_STEPS=8

# Client-side free-tier rate limit (requests per minute).
GEMINI_FREE_TIER_RPM=15
